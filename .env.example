# ------------------------------------------------------------
# Apollo Framework — configuración de entorno
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# ------------------------------------------------------------

# --- Aplicación -------------------------------------------------
APP_NAME="Apollo Framework"
APP_ENV=local            # local | production
APP_DEBUG=true           # true en desarrollo; NUNCA true en producción
APP_URL=http://localhost
APP_KEY=

# --- API ---------------------------------------------------------
# Prefijo/versión global (los prefijos reales por app vienen de apps/<App>/app.json)
API_PREFIX=api
API_VERSION=v1

# --- Base de datos (MySQL) ---------------------------------------
DB_CONNECTION=mysql
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apollo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Base de datos (SQLite — desarrollo sin servidor) -------------
# Usa SQLite para desarrollo rápido (o tests): archivo o memoria.
# Requiere habilitar extension=pdo_sqlite en php.ini.
# DB_CONNECTION=sqlite
# DB_DRIVER=sqlite
# DB_DATABASE=database/development.sqlite   (o :memory: para sesión en memoria)

# --- JWT (obligatorio para autenticación) -------------------------
# Genera un secreto fuerte, p. ej. con:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=apollo-api.local
JWT_AUDIENCE=apollo-client
JWT_EXPIRY=3600                 # segundos (1 hora)
JWT_REFRESH_TTL=20160           # segundos (2 semanas)

# --- Rate limiting ------------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=900            # segundos (15 min)
RATE_LIMIT_LOCKOUT=900           # segundos (15 min)

# --- Mail (módulo core/Mail) ----------------------------------------
MAIL_MAILER=log                  # smtp | log (alias Laravel; MAIL_DRIVER también vale)
MAIL_SCHEME=null                 # null = auto por puerto (465→ssl, 587→tls) | tls | ssl | none
MAIL_FROM_ADDRESS=no-reply@torneomaster.app
MAIL_FROM_NAME="TorneoMaster"
MAIL_HOST=localhost              # p. ej. smtp.resend.com, smtp.gmail.com
MAIL_PORT=587                    # 465 con ssl, 587 con tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=15
MAIL_LOG_PATH=runtime/logs/mail  # solo driver log
MAIL_RETRY=1                     # reintentos adicionales al primer intento
FRONTEND_URL=http://localhost:3000   # URL pública de la app (enlaces de verificación/reset)

# --- Roles & Permissions (módulo de acceso del core) ---------------
AUTH_ACCESS_ENABLED=true

# --- Realtime / WebSockets / Notificaciones (módulo opcional) --------
# Nombres legacy (REALTIME_*). Mantener para compatibilidad.
REALTIME_DRIVER=auto               # auto | redis | local
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8080
REALTIME_MAX_CONNECTIONS=10000
REALTIME_MAX_MESSAGE_SIZE=8192
REALTIME_HEARTBEAT_INTERVAL=30
REALTIME_CONNECTION_TIMEOUT=60
REALTIME_APP_ID=apollo
REALTIME_APP_KEY=app_apollo
REALTIME_APP_SECRET=                # OBLIGATORIO para canales privados
REALTIME_DB_NOTIFICATIONS=true      # persistir notificaciones (migración 009)

# --- WebSockets (alias WEBSOCKET_*; si están vacíos caen a REALTIME_*) ---
# Servidor Workerman (reemplaza OpenSwoole). Instalar con `composer require workerman/workerman`.
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8080
WEBSOCKET_PUBLIC_URL=               # wss://midominio.com/ws en producción (opcional)
WEBSOCKET_MAX_CONNECTIONS=10000
WEBSOCKET_MAX_MESSAGE_SIZE=8192
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_CONNECTION_TIMEOUT=60
WEBSOCKET_APP_KEY=app_apollo
WEBSOCKET_APP_SECRET=               # OBLIGATORIO para /internal/push y canales privados
# Transporte cross-process app → servidor (HttpEventBus; single-instance).
WEBSOCKET_INTERNAL_HOST=127.0.0.1
WEBSOCKET_INTERNAL_PORT=8081
# WSS directo (si no usas Nginx como terminación TLS).
WEBSOCKET_SSL_ENABLED=false
WEBSOCKET_SSL_LOCAL_CERT=
WEBSOCKET_SSL_LOCAL_PKEY=

# --- Redis (opcional; lo detecta el health check de realtime) --------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- Uploads (módulo opcional: subida de archivos) ----------------------
UPLOADS_DRIVER=local               # v1: solo 'local'
UPLOADS_PATH=storage/uploads       # root relativo al proyecto (o absoluto)
UPLOADS_MAX_SIZE=10240             # tamaño máximo en KB (10 MB)
UPLOADS_ALLOWED_MIMES=             # extensiones permitidas; vacío = sin restricción
                                   # (p. ej. jpg,jpeg,png,gif,webp,pdf,zip)
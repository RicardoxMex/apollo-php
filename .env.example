# ------------------------------------------------------------
# Apollo Framework — configuración de entorno
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# ------------------------------------------------------------

# --- Aplicación -------------------------------------------------
APP_NAME="Apollo Framework"
APP_ENV=local            # local | production
APP_DEBUG=true           # true en desarrollo; NUNCA true en producción
APP_URL=http://localhost
APP_KEY=

# --- API ---------------------------------------------------------
# Prefijo/versión global (los prefijos reales por app vienen de apps/<App>/app.json)
API_PREFIX=api
API_VERSION=v1

# --- Base de datos (MySQL) ---------------------------------------
DB_CONNECTION=mysql
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apollo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- JWT (obligatorio para autenticación) -------------------------
# Genera un secreto fuerte, p. ej. con:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=apollo-api.local
JWT_AUDIENCE=apollo-client
JWT_EXPIRY=3600                 # segundos (1 hora)
JWT_REFRESH_TTL=20160           # segundos (2 semanas)

# --- Rate limiting ------------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=900            # segundos (15 min)
RATE_LIMIT_LOCKOUT=900           # segundos (15 min)
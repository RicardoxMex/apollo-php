{
    "name": "ApolloAuth",
    "version": "1.0.0",
    "description": "Sistema de autenticación completo para Apollo Framework",
    "prefix": "api/auth",
    "providers": [
        "Apps\\ApolloAuth\\ApolloAuthServiceProvider"
    ],
    "routes": [
        "auth.php",
        "admin.php"
    ],
    "middleware": {
        "auth": "Apps\\ApolloAuth\\Middleware\\AuthMiddleware",
        "role": "Apollo\\Core\\Auth\\Middleware\\RoleMiddleware",
        "permission": "Apollo\\Core\\Auth\\Middleware\\PermissionMiddleware"
    },
    "dependencies": [],
    "author": "Apollo Framework",
    "license": "MIT"
}
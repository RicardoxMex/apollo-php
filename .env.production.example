# ─────────────────────────────────────────────────────────────────────
# Sport Tournament Pro — API (Apollo) · plantilla de entorno PRODUCCIÓN
#
# Uso:   cp .env.production.example .env   (y rellenar los placeholders)
#
# Reglas:
#   · Este archivo NO lleva secretos reales; el `.env` real está gitignored.
#   · Genera secretos con:  php -r "echo bin2hex(random_bytes(32));"
#   · Con docker-compose, DB_HOST es el nombre del servicio `mysql`.
#   · Checklist de secretos y pasos: docs/deploy.md, docs/operations.md
# ─────────────────────────────────────────────────────────────────────

# --- Aplicación -------------------------------------------------
APP_NAME="Sport Tournament Pro"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.tudominio.com
APP_KEY=                                # ← obligatorio: bin2hex(random_bytes(32))

# --- API ---------------------------------------------------------
API_PREFIX=api
API_VERSION=v1

# --- Base de datos (MySQL de docker-compose) ----------------------
DB_CONNECTION=mysql
DB_DRIVER=mysql
DB_HOST=mysql                           # servicio compose; en VPS nativo: 127.0.0.1
DB_PORT=3306
DB_DATABASE=sport_tournament
DB_USERNAME=sport
DB_PASSWORD=                            # ← contraseña de la app (usuario DB_USERNAME)
DB_ROOT_PASSWORD=                       # ← solo compose: MYSQL_ROOT_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- JWT (obligatorio) ---------------------------------------------
JWT_SECRET_KEY=                         # ← OBLIGATORIO: bin2hex(random_bytes(32))
JWT_ALGORITHM=HS256
JWT_ISSUER=api.tudominio.com
JWT_AUDIENCE=sport-tournament-front
JWT_EXPIRY=3600
JWT_REFRESH_TTL=20160

# --- Rate limiting --------------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=900
RATE_LIMIT_LOCKOUT=900

# --- Mail (SMTP; en producción Resend) --------------------------------
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@tudominio.com
MAIL_FROM_NAME="TorneoMaster"
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=                          # ← API key de Resend (secreto)
MAIL_ENCRYPTION=tls
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=15
MAIL_LOG_PATH=runtime/logs/mail         # solo driver log
MAIL_RETRY=1
FRONTEND_URL=https://tudominio.com      # enlaces de verificación/reset

# --- Uploads --------------------------------------------------------
UPLOADS_DRIVER=local
UPLOADS_PATH=storage/uploads
UPLOADS_MAX_SIZE=10240
UPLOADS_ALLOWED_MIMES=jpg,jpeg,png,gif,webp

# --- Roles & permisos ------------------------------------------------
AUTH_ACCESS_ENABLED=true

# --- Realtime / WebSockets (opcional: requiere servicio aparte) ------
# Si no se despliega el servicio realtime, dejar WEBSOCKET_ENABLED=false.
WEBSOCKET_ENABLED=false
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080
WEBSOCKET_PUBLIC_URL=wss://api.tudominio.com/ws
WEBSOCKET_APP_KEY=app_apollo
WEBSOCKET_APP_SECRET=                   # ← OBLIGATORIO si WEBSOCKET_ENABLED=true
WEBSOCKET_INTERNAL_HOST=127.0.0.1
WEBSOCKET_INTERNAL_PORT=8081
WEBSOCKET_DB_NOTIFICATIONS=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
